@using QuickCode.Freytz.Portal.Models.MainModule
@model MainModule.AuditLogData
@{
    string title =  "MainModule.AuditLog List".SplitCamelCaseToString();
    string headerKey = "Header";
    TempData["Title"] = title;
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage ) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex } ;
}
<div class="container-fluid" IsPageAvailable="true">
    <form method="post" id="formList">
        @Html.AntiForgeryToken()
        <div class="card text shadow mb-4">
            
            <div class="card-body">
                <h2 class="card-title">@title</h2>
                <p class="card-text">You can manage your MainModule.AuditLog table.</p>
                <vc:insert-button controller-name="" action-name=""></vc:insert-button>
                <hr class="col-xs-12">
                 @if (Model.List.Count == 0)
                {
                    <div class="alert alert-danger" role="alert">
                        No Data available in MainModule.AuditLog table.
                    </div>
                }
                else
                {
                    <vc:pager pager-data=pagerData></vc:pager>
                    <div class="table-responsive portal-table-scroll">
                    <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
                        <thead bc-theme="Dark">
                            <tr>
                               <vc:operation-buttons item-id=@headerKey controller-name="" action-name=""></vc:operation-buttons>
                               <th>Entity Name</th>
<th>Entity Id</th>
<th>Action</th>
<th>User Id</th>
<th>User Name</th>
<th>User Group</th>
<th>Timestamp</th>
<th>Duration Ms</th>
<th>Status Code</th>
<th>Request Module</th>
<th>Request Path</th>
<th>Old Values</th>
<th>New Values</th>
<th>Changed Columns</th>
<th>Is Changed</th>
<th>Change Summary</th>
<th>Ip Address</th>
<th>User Agent</th>
<th>Correlation Id</th>
<th>Is Success</th>
<th>Error Message</th>
<th>Hash</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.List)
                            {
                            <tr>
                                <vc:operation-buttons item-id=@item.GetKey() controller-name="" action-name=""></vc:operation-buttons>
                                <td>@item.EntityName</td>
<td>@item.EntityId</td>
<td>@item.Action</td>
<td>@item.UserId</td>
<td>@item.UserName</td>
<td>@item.UserGroup</td>
<td>@item.Timestamp</td>
<td>@item.DurationMs</td>
<td>@item.StatusCode</td>
<td>@item.RequestModule</td>
<td>@item.RequestPath</td>
<td>@item.OldValues</td>
<td>@item.NewValues</td>
<td>@item.ChangedColumns</td>
<td>@if (item.IsChanged == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsChanged" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsChanged" disabled />
    </div>
}
</td>
<td>@item.ChangeSummary</td>
<td>@item.IpAddress</td>
<td>@item.UserAgent</td>
<td>@item.CorrelationId</td>
<td>@if (item.IsSuccess == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsSuccess" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_IsSuccess" disabled />
    </div>
}
</td>
<td>@item.ErrorMessage</td>
<td>@item.Hash</td>

                               </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </div>
            @if (Model.List.Count > 0)
            {
            <div class="card-footer text-muted">
                 <vc:pager pager-data=pagerData></vc:pager>
            </div>
            }
        </div>
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="SelectedKey" />
    </form>

    <div class="modal fade bd-example-modal-lg" id="itemDetailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document" id="itemDetailsContainer">
        </div>
    </div>
    
</div>
<div class="container-fluid" IsPageAvailable="false">
 @await Html.PartialAsync("_NotAuthorized")
</div>

<script type="text/javascript">
    window.addEventListener('load', (event) => {
     $("img.lazyload").lazyload();
    });
</script>

