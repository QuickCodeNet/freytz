@using QuickCode.Freytz.Portal.Models.MainModule
@model MainModule.ShipmentData
@{
    string title =  "MainModule.Shipment List".SplitCamelCaseToString();
    string headerKey = "Header";
    TempData["Title"] = title;
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage ) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex } ;
}
<div class="container-fluid" IsPageAvailable="true">
    <form method="post" id="formList">
        @Html.AntiForgeryToken()
        <div class="card text shadow mb-4">
            
            <div class="card-body">
                <h2 class="card-title">@title</h2>
                <p class="card-text">You can manage your MainModule.Shipment table.</p>
                <vc:insert-button controller-name="" action-name=""></vc:insert-button>
                <hr class="col-xs-12">
                 @if (Model.List.Count == 0)
                {
                    <div class="alert alert-danger" role="alert">
                        No Data available in MainModule.Shipment table.
                    </div>
                }
                else
                {
                    <vc:pager pager-data=pagerData></vc:pager>
                    <div class="table-responsive portal-table-scroll">
                    <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
                        <thead bc-theme="Dark">
                            <tr>
                               <vc:operation-buttons item-id=@headerKey controller-name="" action-name=""></vc:operation-buttons>
                               <th>Id</th>
<th>Customer Id</th>
<th>Driver Id</th>
<th>Shipment Type</th>
<th>Create Date</th>
<th>Start Date</th>
<th>Finish Date</th>
<th>Planned Arrive Time</th>
<th>Shipment Status</th>
<th>Payment Id</th>
<th>Planned Duration</th>
<th>Total Distance</th>
<th>Driver Instructions</th>
<th>State Id</th>
<th>Vehicle Type Id</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.List)
                            {
                            <tr>
                                <vc:operation-buttons item-id=@item.GetKey() controller-name="" action-name=""></vc:operation-buttons>
                                <td>@item.Id</td>
<td>			@string.Format("{0}", Model.GetComboBoxValue("Customers", item.CustomerId))</td>
<td>			@string.Format("{0}", Model.GetComboBoxValue("Drivers", item.DriverId))</td>
<td>@item.ShipmentType</td>
<td>@item.CreateDate</td>
<td>@item.StartDate</td>
<td>@item.FinishDate</td>
<td>@item.PlannedArriveTime</td>
<td>@item.ShipmentStatus</td>
<td>			@string.Format("{0}", Model.GetComboBoxValue("Payments", item.PaymentId))</td>
<td>@item.PlannedDuration</td>
<td>@item.TotalDistance</td>
<td>@item.DriverInstructions</td>
<td>			@string.Format("{0}", Model.GetComboBoxValue("States", item.StateId))</td>
<td>			@string.Format("{0}", Model.GetComboBoxValue("VehicleTypes", item.VehicleTypeId))</td>

                               </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </div>
            @if (Model.List.Count > 0)
            {
            <div class="card-footer text-muted">
                 <vc:pager pager-data=pagerData></vc:pager>
            </div>
            }
        </div>
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="SelectedKey" />
    </form>

    <div class="modal fade bd-example-modal-lg" id="itemDetailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document" id="itemDetailsContainer">
        </div>
    </div>
    
</div>
<div class="container-fluid" IsPageAvailable="false">
 @await Html.PartialAsync("_NotAuthorized")
</div>

<script type="text/javascript">
    window.addEventListener('load', (event) => {
     $("img.lazyload").lazyload();
    });
</script>

