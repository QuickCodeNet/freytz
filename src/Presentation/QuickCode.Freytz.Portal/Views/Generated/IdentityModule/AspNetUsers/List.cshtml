@using QuickCode.Freytz.Portal.Models.IdentityModule
@model IdentityModule.AspNetUserData
@{
    string title =  "IdentityModule.AspNetUser List".SplitCamelCaseToString();
    string headerKey = "Header";
    TempData["Title"] = title;
    int startIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    int endIndex = ((Model.CurrentPage ) * Model.PageSize);
    if (endIndex > Model.NumberOfRecord) {
        endIndex = Model.NumberOfRecord;
    }

    var pagerData = new PagerData() { CurrentPage = Model.CurrentPage, NumberOfRecord = Model.NumberOfRecord, PageSize = Model.PageSize, TotalPage = Model.TotalPage, StartIndex = startIndex, EndIndex = endIndex } ;
}
<div class="container-fluid" IsPageAvailable="true">
    <form method="post" id="formList">
        @Html.AntiForgeryToken()
        <div class="card text shadow mb-4">
            
            <div class="card-body">
                <h2 class="card-title">@title</h2>
                <p class="card-text">You can manage your IdentityModule.AspNetUser table.</p>
                <vc:insert-button controller-name="" action-name=""></vc:insert-button>
                <hr class="col-xs-12">
                 @if (Model.List.Count == 0)
                {
                    <div class="alert alert-danger" role="alert">
                        No Data available in IdentityModule.AspNetUser table.
                    </div>
                }
                else
                {
                    <vc:pager pager-data=pagerData></vc:pager>
                    <div class="table-responsive portal-table-scroll">
                    <table bc-border="Bordered" bc-striped="true" bc-hover="true" class="table" bc-theme="Light">
                        <thead bc-theme="Dark">
                            <tr>
                               <vc:operation-buttons item-id=@headerKey controller-name="" action-name=""></vc:operation-buttons>
                               <th>Id</th>
<th>First Name</th>
<th>Last Name</th>
<th>Permission Group Name</th>
<th>User Name</th>
<th>Normalized User Name</th>
<th>Email</th>
<th>Normalized Email</th>
<th>Email Confirmed</th>
<th>Phone Number</th>
<th>Phone Number Confirmed</th>
<th>Two Factor Enabled</th>
<th>Lockout End</th>
<th>Lockout Enabled</th>
<th>Access Failed Count</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.List)
                            {
                            <tr>
                                <vc:operation-buttons item-id=@item.GetKey() controller-name="" action-name=""></vc:operation-buttons>
                                <td>@item.Id</td>
<td>@item.FirstName</td>
<td>@item.LastName</td>
<td>			@string.Format("{0}", Model.GetComboBoxValue("PermissionGroups", item.PermissionGroupName))</td>
<td>@item.UserName</td>
<td>@item.NormalizedUserName</td>
<td>@item.Email</td>
<td>@item.NormalizedEmail</td>
<td>@if (item.EmailConfirmed == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_EmailConfirmed" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_EmailConfirmed" disabled />
    </div>
}
</td>
<td>@item.PhoneNumber</td>
<td>@if (item.PhoneNumberConfirmed == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_PhoneNumberConfirmed" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_PhoneNumberConfirmed" disabled />
    </div>
}
</td>
<td>@if (item.TwoFactorEnabled == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_TwoFactorEnabled" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_TwoFactorEnabled" disabled />
    </div>
}
</td>
<td>@item.LockoutEnd</td>
<td>@if (item.LockoutEnabled == true)
{
    <div class="ios-switch-wrapper checked">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_LockoutEnabled" checked disabled />
    </div>
}
else
{
    <div class="ios-switch-wrapper">
        <input class="ios-switch" type="checkbox" onchange="checkBoxChanged(this);" id="cbox_item_LockoutEnabled" disabled />
    </div>
}
</td>
<td>@item.AccessFailedCount</td>

                               </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </div>
            @if (Model.List.Count > 0)
            {
            <div class="card-footer text-muted">
                 <vc:pager pager-data=pagerData></vc:pager>
            </div>
            }
        </div>
        <input type="hidden" asp-for="CurrentPage" />
        <input type="hidden" asp-for="SelectedKey" />
    </form>

    <div class="modal fade bd-example-modal-lg" id="itemDetailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document" id="itemDetailsContainer">
        </div>
    </div>
    
</div>
<div class="container-fluid" IsPageAvailable="false">
 @await Html.PartialAsync("_NotAuthorized")
</div>

<script type="text/javascript">
    window.addEventListener('load', (event) => {
     $("img.lazyload").lazyload();
    });
</script>

